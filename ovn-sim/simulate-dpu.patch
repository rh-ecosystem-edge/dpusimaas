@@ -117,6 +118,10 @@ type DPUCNIProvisioner struct {
 	BootstrapKubeconfigPath string
 	// HostNodeNameFilePath is where the mapped host node name is written. Defaults to hostNodeNameFilePath.
 	HostNodeNameFilePath string
+	// SimulateDPU is for a simulated DPU (e.g. a VM), whose host PF has no switchdev representor to read its
+	// MAC from: the host PF MAC is derived from the host node name instead, as OVN-Kubernetes'
+	// --simulate-dpu mode derives it.
+	SimulateDPU bool
 
 	// vtepIPNet is the IP that should be added to the VTEP interface.
 	vtepIPNet *net.IPNet
@@ -652,6 +657,25 @@ func (p *DPUCNIProvisioner) runNetplanApply() error {
 	return nil
 }
 
+// hostPFMACAddress returns the MAC of the host's PF0, which the DHCP server hands the PF IP to.
+func (p *DPUCNIProvisioner) hostPFMACAddress() (net.HardwareAddr, error) {
+	if p.SimulateDPU {
+		return SimulatedHostPFMACAddress(p.hostNodeName)
+	}
+	return p.networkHelper.GetHostPFMACAddressDPU("0")
+}
+
+// SimulatedHostPFMACAddress is the host PF MAC of a simulated DPU's host, the one OVN-Kubernetes'
+// --simulate-dpu mode derives for the host gateway interface (index 0):
+// 52:54:00 + sha256("<hostNodeName>\x00host")[0:2] + 00.
+func SimulatedHostPFMACAddress(hostNodeName string) (net.HardwareAddr, error) {
+	if hostNodeName == "" {
+		return nil, errors.New("the host node name is required to derive a simulated host PF MAC")
+	}
+	h := sha256.Sum256([]byte(hostNodeName + "\x00host"))
+	return net.HardwareAddr{0x52, 0x54, 0x00, h[0], h[1], 0x00}, nil
+}
+
 // startDHCPServer starts a DHCP Server to enable the PF on the host to get an IP.
 func (p *DPUCNIProvisioner) startDHCPServer() error {
 	if p.dhcpCmd != nil {
@@ -664,7 +688,7 @@ func (p *DPUCNIProvisioner) startDHCPServer() error {
 		return fmt.Errorf("error while parsing network from VTEP IP %s: %w", p.vtepIPNet.String(), err)
 	}
 
-	mac, err := p.networkHelper.GetHostPFMACAddressDPU("0")
+	mac, err := p.hostPFMACAddress()
 	if err != nil {
 		return fmt.Errorf("error while parsing MAC address of the PF on the host: %w", err)
 	}
