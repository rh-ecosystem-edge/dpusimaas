+/*
+ * Minimal VPD: a write of an address with the F flag clear loads the dword at
+ * that address into the data register and sets F, which is what Linux's
+ * pci_vpd_read() polls for.
+ */
+static void igb_vpd_write_config(IGBState *s, uint32_t addr, int len)
+{
+    PCIDevice *dev = PCI_DEVICE(s);
+    uint32_t reg = s->vpd_cap + PCI_VPD_ADDR;
+    uint16_t vaddr;
+
+    if (!s->vpd_cap || !ranges_overlap(addr, len, reg, 2)) {
+        return;
+    }
+    vaddr = pci_get_word(dev->config + reg);
+    if (vaddr & PCI_VPD_ADDR_F) {
+        return;
+    }
+    vaddr &= PCI_VPD_ADDR_MASK & ~3;
+    if (vaddr + 4 <= sizeof(s->vpd)) {
+        memcpy(dev->config + s->vpd_cap + PCI_VPD_DATA, s->vpd + vaddr, 4);
+    } else {
+        pci_set_long(dev->config + s->vpd_cap + PCI_VPD_DATA, 0);
+    }
+    pci_set_word(dev->config + reg, vaddr | PCI_VPD_ADDR_F);
+}
+
+/*
+ * The VPD image of a BlueField-3: identifier string, VPD-R with the serial
+ * number (SN), end tag.
+ */
+static void igb_init_vpd(IGBState *s, Error **errp)
+{
+    PCIDevice *dev = PCI_DEVICE(s);
+    static const char ident[] = "BlueField-3";
+    size_t ilen = strlen(ident), slen = strlen(s->vpd_serial);
+    uint8_t *p = s->vpd;
+    int ret;
+
+    if (slen > 0xff || 3 + ilen + 3 + 3 + slen + 1 > sizeof(s->vpd)) {
+        error_setg(errp, "x-vpd-serial too long");
+        return;
+    }
+    memset(s->vpd, 0, sizeof(s->vpd));
+    *p++ = 0x82;                         /* large resource: identifier */
+    *p++ = ilen & 0xff;
+    *p++ = ilen >> 8;
+    memcpy(p, ident, ilen);
+    p += ilen;
+    *p++ = 0x90;                         /* large resource: VPD-R */
+    *p++ = (3 + slen) & 0xff;
+    *p++ = (3 + slen) >> 8;
+    *p++ = 'S';
+    *p++ = 'N';
+    *p++ = slen;
+    memcpy(p, s->vpd_serial, slen);
+    p += slen;
+    *p++ = 0x78;                         /* small resource: end */
+
+    ret = pci_add_capability(dev, PCI_CAP_ID_VPD, IGB_CAP_VPD_OFFSET, 8, errp);
+    if (ret < 0) {
+        return;
+    }
+    s->vpd_cap = ret;
+    pci_set_word(dev->wmask + ret + PCI_VPD_ADDR, 0xffff);
+}
