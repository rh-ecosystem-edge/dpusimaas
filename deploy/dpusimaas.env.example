# Copy to ~/.config/dpusimaas/machines.env and edit it for your lab.

# The aarch64 hypervisor that runs dpusimaas and the DPU VMs.
HOST=arm-hypervisor.example.com

# The x86 hypervisor that runs host-trusted lease hosts. Leave empty for zero-trust only.
X86_HV=x86-hypervisor.example.com

# Installation and admission-control settings.
PREFIX=/opt/dpusimaas
MAX_DPUS=4
MAX_HOSTS=3

# Optional settings for deploy/prepare-x86-hv.sh.
X86_STORAGE_DIR=/var/lib/libvirt/images
X86_BRIDGE_MTU=9000
X86_LAN_INTERFACE=
# Set to 0 to skip building the patched QEMU.
BUILD_QEMU=1

# Optional settings for deploy/prepare-arm-hv.sh.
ARM_LAN_INTERFACE=
ARM_STORAGE_DIR=/var/lib/libvirt/images
ARM_BRIDGE_MTU=1500
